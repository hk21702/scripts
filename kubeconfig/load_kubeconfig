#!/bin/bash

# Define Colors using ANSI-C quoting
RED=$'\033[0;31m'
GREEN=$'\033[1;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'
DIM_GRAY=$'\033[90m'
NC=$'\033[0m' # No Color

# Define the directory where your kubeconfigs are stored
KUBE_DIR="${HOME}/.kube/configs"

# Check if directory exists
if [ ! -d "$KUBE_DIR" ]; then
    echo "${RED}Error: Directory ${KUBE_DIR} does not exist.${NC}"
    echo "${YELLOW}Please create it and add your kubeconfig files there.${NC}"
    return 1 2>/dev/null || exit 1
fi

# Populate array with files from the directory
configs=()
for file in "$KUBE_DIR"/*; do
    if [ -f "$file" ]; then
        configs+=("$(basename "$file")")
    fi
done

# Check if we found any files
if [ ${#configs[@]} -eq 0 ]; then
    echo "${YELLOW}No files found in ${KUBE_DIR}.${NC}"
    return 1 2>/dev/null || exit 1
fi

echo "${CYAN}=======================================${NC}"
echo "${CYAN}       Select a Kubeconfig File        ${NC}"
echo "${CYAN}=======================================${NC}"

# Loop through the array to build the custom menu
for i in "${!configs[@]}"; do
    raw_name="${configs[$i]}"
    
    # Alternate line formatting for readability
    if (( i % 2 == 0 )); then
        BASE_COLOR="${NC}"
        NUM_COLOR="${CYAN}"
    else
        BASE_COLOR="${DIM_GRAY}"
        NUM_COLOR="${DIM_GRAY}"
    fi

    # Highlight specific environments
    disp_name="${raw_name//stg/${YELLOW}stg${BASE_COLOR}}"
    disp_name="${disp_name//prod/${GREEN}prod${BASE_COLOR}}"
    
    # Print the option, 1-indexed
    printf "${NUM_COLOR}%3d)${NC} ${BASE_COLOR}%s${NC}\n" "$((i + 1))" "$disp_name"
done

# Add default operations dynamically
num_unset=$(( ${#configs[@]} + 1 ))
num_quit=$(( ${#configs[@]} + 2 ))

echo "---"
printf "${CYAN}%3d)${NC} Unset KUBECONFIG (Use Default)\n" "$num_unset"
printf "${RED}%3d)${NC} Quit\n" "$num_quit"
echo ""

# Handle User Input
while true; do
    if ! read -r -p "${YELLOW}Choice: ${NC}" choice; then
        echo "${RED}No selection received.${NC}" >&2
        return 1 2>/dev/null || exit 1
    fi

    if ! [[ "$choice" =~ ^[0-9]+$ ]]; then
        echo "${RED}Invalid input. Please enter a number.${NC}"
        continue
    fi

    if (( choice == num_unset )); then
        unset KUBECONFIG
        echo -e "\n${GREEN}✔ KUBECONFIG unset.${NC} Using default (~/.kube/config)."
        break
    elif (( choice == num_quit )); then
        echo -e "\n${YELLOW}Exiting without changes.${NC}"
        break
    elif (( choice > 0 && choice <= ${#configs[@]} )); then
        index=$((choice - 1))
        selected_file="${configs[$index]}"
        
        # 1. Export the KUBECONFIG
        export KUBECONFIG="$KUBE_DIR/$selected_file"
        echo -e "\n${GREEN}✔ KUBECONFIG set to:${NC} $KUBECONFIG"
        
        if command -v kubectl &> /dev/null; then
            # 2. Extract the namespace (filename minus the extension)
            extracted_ns="${selected_file%.*}"

            # 3. Set the default namespace for the current context
            if ! kubectl config set-context --current --namespace="$extracted_ns" >/dev/null; then
                echo "${RED}Failed to set the default namespace to ${extracted_ns}.${NC}" >&2
                return 1 2>/dev/null || exit 1
            fi
            
            # 4. Print the active context and namespace
            ctx=$(kubectl config current-context 2>/dev/null)
            echo "${CYAN}Current Context:${NC} $ctx"
            echo "${CYAN}Default Namespace:${NC} $extracted_ns"
        fi
        break
    else
        echo "${RED}Invalid option out of range. Try again.${NC}"
    fi
done
