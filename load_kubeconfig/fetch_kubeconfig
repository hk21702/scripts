#!/bin/bash

set -eo pipefail

KUBE_DIR="${HOME}/.kube/configs"
VAULT_FIELD="kubeconfig_b64"
force=false

usage() {
	cat <<'EOF'
Usage: fetch_kubeconfig [--force] VAULT_PATH [NAME]

Fetch a base64-encoded kubeconfig from Vault and save it under
~/.kube/configs. NAME defaults to the parent component of VAULT_PATH.
If the current Vault token is missing or expired, prompt for a token.

Examples:
  fetch_kubeconfig secret/services/k8s-prod-documentation-ps7-ubuntu-wiki/kubeconfig
  fetch_kubeconfig secret/services/k8s-prod-documentation-ps7-ubuntu-wiki/kubeconfig prod-documentation
EOF
}

if [[ "${1:-}" == "--force" ]]; then
	force=true
	shift
fi

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
	usage
	exit 0
fi

if (($# < 1 || $# > 2)); then
	usage >&2
	exit 2
fi

if ! command -v vault >/dev/null 2>&1; then
	echo "Error: vault is not installed or is not in PATH." >&2
	exit 1
fi

if ! vault token lookup >/dev/null 2>&1; then
	echo "No valid Vault token found. Starting interactive login..."
	vault login
fi

vault_path="${1%/}"
default_name="$(basename "$(dirname "$vault_path")")"
name="${2:-$default_name}"

if [[ -z "$name" || "$name" == "." || "$name" == ".." || "$name" == */* ]]; then
	echo "Error: NAME must be a single, non-empty filename." >&2
	exit 2
fi

if [[ "$name" != *.yaml && "$name" != *.yml ]]; then
	name="${name}.yaml"
fi

mkdir -p "$KUBE_DIR"
chmod 700 "$KUBE_DIR"
destination="${KUBE_DIR}/${name}"

if [[ -e "$destination" && "$force" != true ]]; then
	echo "Error: ${destination} already exists. Use --force to replace it." >&2
	exit 1
fi

umask 077
temp_file="$(mktemp "${KUBE_DIR}/.${name}.XXXXXX")"
trap 'rm -f "$temp_file"' EXIT

echo "Fetching ${vault_path}..."
vault kv get -field="$VAULT_FIELD" "$vault_path" | base64 --decode >"$temp_file"

if [[ ! -s "$temp_file" ]]; then
	echo "Error: Vault returned an empty kubeconfig." >&2
	exit 1
fi

if command -v kubectl >/dev/null 2>&1; then
	if ! kubectl config view --kubeconfig="$temp_file" >/dev/null; then
		echo "Error: decoded value is not a valid kubeconfig." >&2
		exit 1
	fi
fi

mv -f "$temp_file" "$destination"
trap - EXIT
echo "Saved kubeconfig to ${destination}"
